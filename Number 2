    if d.Name:lower():find("bobber", 1, true) then pcall(trackBobber, d) end
end

---------------------------------------------------------------- GUI changes (PlayerGui is already local)
local function watchGui(o)
    if o:IsDescendantOf(gui) then return end
    if o:IsA("GuiObject") then
        o:GetPropertyChangedSignal("Visible"):Connect(function()
            logk("vis:" .. o.Name, "GUI " .. (o.Visible and "SHOW " or "hide ") .. o:GetFullName())
        end)
    end
    if o:IsA("TextLabel") or o:IsA("TextButton") then
        o:GetPropertyChangedSignal("Text"):Connect(function()
            local t = o.Text
            if t and t:match("%a") and #t < 80 then
                logk("text:" .. o.Name, "TEXT " .. o:GetFullName() .. " = " .. t)
            end
        end)
    end
end
for _, d in ipairs(pg:GetDescendants()) do pcall(watchGui, d) end
pg.DescendantAdded:Connect(function(d)
    pcall(watchGui, d)
    if d:IsA("GuiObject") and not d:IsDescendantOf(gui) then
        local extra = ""
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then extra = " = " .. d.Text end
        logk("newgui:" .. d.ClassName .. ":" .. d.Name, "NEW GUI " .. d.ClassName .. " " .. d:GetFullName() .. extra)
    end
end)

