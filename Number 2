local SETTINGS_FILE = "FishLogSettings.json"
local settings = { automute = true, sens = 2 }
pcall(function()
    if isfile and readfile and isfile(SETTINGS_FILE) then
        local d = HttpService:JSONDecode(readfile(SETTINGS_FILE))
        if type(d.automute) == "boolean" then settings.automute = d.automute end
        if SENS[d.sens] then settings.sens = d.sens end
    end
end)
