---------------------------------------------------------------- spam detection + auto-mute
local stats = {}   -- key -> { t, n, strikes, rate }
local muted = {}   -- key -> { rate = peak per second, suppressed = count }
local muteButtons = {}

local function refreshMutePanel()
    for _, b in pairs(muteButtons) do b:Destroy() end
    muteButtons = {}
    local count = 0
    for key, info in pairs(muted) do
        count += 1
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 0)
        b.AutomaticSize = Enum.AutomaticSize.Y
        b.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
        b.TextColor3 = Color3.new(1, 1, 1)
        b.TextXAlignment = Enum.TextXAlignment.Left
        b.TextWrapped = true
        b.Font = Enum.Font.Code
        b.TextSize = 11
        b.Text = string.format("%s\n~%d/s, %d hidden", key, info.rate, info.suppressed)
        b.Parent = muteScroll
        b.MouseButton1Click:Connect(function()
            muted[key] = nil
            stats[key] = nil
            log("UNMUTED " .. key)
            refreshMutePanel()
        end)
        muteButtons[key] = b
    end
    muteTitle.Text = "MUTED: " .. count .. (settings.automute and " (tap to unmute)" or " (auto-mute OFF)")
end

unmuteAll.MouseButton1Click:Connect(function()
    muted = {}
    stats = {}
    log("UNMUTED ALL")
    refreshMutePanel()
end)

-- HOLDING QUEUE: nothing from a source goes straight to the GUI. Each line waits HOLD seconds in a hidden
-- queue while we count how often that source fires. If it spams, it is muted and every held line from it is
-- thrown away (so none of it is ever shown). Quiet sources are released to the GUI after the hold, with their
-- original timestamp. Already-muted sources never enter the queue at all.
local pending = {}

-- normalise changing numbers / ids in names so "Fish123", "Fish124"... count as ONE source
local function normalize(key)
    return (key:gsub("%x%x%x%x%x%x+", "#"):gsub("%d+", "#"))
end

-- cheap pre-check (use it before building expensive text, e.g. decoding remote args)
local function isMuted(key)
    if not settings.automute then return false end
    local m = muted[normalize(key)]
    if m then
        m.suppressed += 1
        return true
    end
    return false
end

local function logk(key, text)
    if not settings.automute then -- setting OFF: no holding, no muting, everything shows live
        log(text)
        return
    end
    key = normalize(key)
    if muted[key] then
        muted[key].suppressed += 1
        return
    end
    local now = os.clock()
    local s = stats[key]
    if not s then
        s = { times = {} }
        stats[key] = s
    end
    local times = s.times
    table.insert(times, now)
    while times[1] and now - times[1] > HOLD do table.remove(times, 1) end

    if #times >= SENS[settings.sens][2] then
        muted[key] = { rate = math.floor(#times / HOLD), suppressed = 0 }
        -- drop everything this source still has waiting, so none of it is shown
        for i = #pending, 1, -1 do
            if pending[i].key == key then table.remove(pending, i) end
        end
        log("AUTO-MUTED (spam) " .. key)
        refreshMutePanel()
        return
    end

    if #pending >= PENDING_MAX then table.remove(pending, 1) end
    table.insert(pending, { key = key, text = text, t = now })
end

-- release loop: only lines that survived the hold AND are still not muted reach the GUI
task.spawn(function()
    local shown = { t = 0, n = 0 }
    while gui.Parent do
        task.wait(0.1)
        local now = os.clock()
        while pending[1] and now - pending[1].t >= HOLD do
            local e = table.remove(pending, 1)
            if not muted[e.key] then
                if now - shown.t > 1 then shown.t, shown.n = now, 0 end
                shown.n += 1
                if shown.n <= GLOBAL_MAX then log(e.text, e.t) end
            end
        end
    end
end)

