---------------------------------------------------------------- decoding helpers
local function fmtV(v) return string.format("%.1f,%.1f,%.1f", v.X, v.Y, v.Z) end

local function decodeBuffer(b)
    local len = buffer.len(b)
    local hexParts, ascii, bytes = table.create(len), table.create(len), table.create(len)
    for i = 0, len - 1 do
        local byte = buffer.readu8(b, i)
        hexParts[i + 1] = string.format("%02x", byte)
        ascii[i + 1] = (byte >= 32 and byte < 127) and string.char(byte) or "."
        bytes[i + 1] = tostring(byte)
    end
    local out = {
        string.format("BUFFER[%d bytes]", len),
        "hex=" .. table.concat(hexParts, " "),
        "ascii=\"" .. table.concat(ascii) .. "\"",
        "u8=" .. table.concat(bytes, ","),
    }
    if len >= 2 then
        local v = {}
        for i = 0, len - 2, 2 do table.insert(v, tostring(buffer.readi16(b, i))) end
        table.insert(out, "i16=" .. table.concat(v, ","))
    end
    if len >= 4 then
        local iv, fv = {}, {}
        for i = 0, len - 4, 4 do
            table.insert(iv, tostring(buffer.readi32(b, i)))
            table.insert(fv, string.format("%.3f", buffer.readf32(b, i)))
        end
        table.insert(out, "i32=" .. table.concat(iv, ","))
        table.insert(out, "f32=" .. table.concat(fv, ","))
    end
    if len >= 8 and len % 8 == 0 then
        local dv = {}
        for i = 0, len - 8, 8 do table.insert(dv, string.format("%.4f", buffer.readf64(b, i))) end
        table.insert(out, "f64=" .. table.concat(dv, ","))
    end
    return table.concat(out, " ")
end

local fmt
fmt = function(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "buffer" then return decodeBuffer(v) end
    if t == "string" then
        local first = v:sub(1, 1)
        if first == "{" or first == "[" then
            local ok, decoded = pcall(function() return HttpService:JSONDecode(v) end)
            if ok then return "JSON" .. fmt(decoded, depth + 1) end
        end
        return string.format("%q", v)
    end
    if t == "Instance" then return v:GetFullName() .. " <" .. v.ClassName .. ">" end
    if t == "Vector3" then return "V3(" .. fmtV(v) .. ")" end
    if t == "Vector2" then return string.format("V2(%.1f,%.1f)", v.X, v.Y) end
    if t == "CFrame" then return "CF(" .. fmtV(v.Position) .. ")" end
    if t == "Color3" then return string.format("RGB(%d,%d,%d)", v.R * 255, v.G * 255, v.B * 255) end
    if t == "UDim2" then return tostring(v) end
    if t == "EnumItem" then return tostring(v) end
    if t == "number" then
        if v % 1 == 0 then return tostring(v) end
        return string.format("%.4f", v)
    end
    if t == "table" then
        if depth > 4 then return "{...}" end
        local parts, n = {}, 0
        local isArray = #v > 0
        for k, x in pairs(v) do
            n += 1
            if n > 40 then table.insert(parts, "...") break end
            if isArray and type(k) == "number" then
                table.insert(parts, fmt(x, depth + 1))
            else
                table.insert(parts, tostring(k) .. "=" .. fmt(x, depth + 1))
            end
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function join(...)
    local args = table.pack(...)
    local out = {}
    for i = 1, args.n do out[i] = fmt(args[i]) end
    return table.concat(out, " | ")
end

---------------------------------------------------------------- "is this mine?" helpers
local function inOtherCharacter(inst)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character and inst:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

local function posOf(inst)
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("Model") then
        local ok, cf = pcall(function() return inst:GetPivot() end)
        if ok then return cf.Position end
    end
    local p = inst.Parent
    if p and p:IsA("BasePart") then return p.Position end
    return nil
end

local function isMine(inst)
    local char = lp.Character
    if char and inst:IsDescendantOf(char) then return true end
    if inOtherCharacter(inst) then return false end

    local cur = inst
    while cur and cur ~= game do
        local n = cur.Name
        if n == lp.Name or n == lp.DisplayName or n == tostring(lp.UserId) then return true end
        local ok, attrs = pcall(function() return cur:GetAttributes() end)
        if ok then
            for _, v in pairs(attrs) do
                if v == lp.Name or v == lp.DisplayName or v == lp.UserId then return true end
                if typeof(v) == "Instance" and (v == lp or v == char) then return true end
            end
        end
        cur = cur.Parent
    end

    local root = char and char:FindFirstChild("HumanoidRootPart")
    local pos = posOf(inst)
    if root and pos and (pos - root.Position).Magnitude <= NEAR then return true end
    return false
end

-- true if a remote's args point at some OTHER player
local function mentionsOther(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "Instance" then
        if v:IsA("Player") then return v ~= lp end
        return inOtherCharacter(v)
    elseif t == "string" or t == "number" then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and (v == p.Name or v == p.DisplayName or v == p.UserId) then return true end
        end
    elseif t == "table" and depth < 3 then
        for k, x in pairs(v) do
            if mentionsOther(k, depth + 1) or mentionsOther(x, depth + 1) then return true end
        end
    end
    return false
end

---------------------------------------------------------------- remotes: sent (always you)
local hooked = false
if hookfunction then
    for _, def in ipairs({ { "RemoteEvent", "FireServer" }, { "RemoteFunction", "InvokeServer" }, { "UnreliableRemoteEvent", "FireServer" } }) do
        pcall(function()
            local fn = Instance.new(def[1])[def[2]]
            local old
            old = hookfunction(fn, function(self, ...)
                if typeof(self) == "Instance" and not isMuted("send:" .. self.Name) then
                    task.defer(logk, "send:" .. self.Name, "SEND " .. self.Name .. " | " .. join(...))
                end
                return old(self, ...)
            end)
            hooked = true
        end)
    end
end
if not hooked and hookmetamethod and getnamecallmethod then
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" and not isMuted("send:" .. self.Name) then
            task.defer(logk, "send:" .. self.Name, "SEND " .. self.Name .. " | " .. join(...))
        end
        return old(self, ...)
    end)
    hooked = true
end
log(hooked and "send hook installed" or "NO send hook possible")

---------------------------------------------------------------- remotes: received (skip other players' events)
local names = {}
local function hookRecv(r)
    pcall(function()
        if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
            table.insert(names, r.Name)
            r.OnClientEvent:Connect(function(...)
                local args = table.pack(...)
                for i = 1, args.n do
                    if mentionsOther(args[i]) then return end
                end
                if not isMuted("recv:" .. r.Name) then
                    logk("recv:" .. r.Name, "RECV " .. r.Name .. " | " .. join(...))
                end
            end)
        end
    end)
end
for _, d in ipairs(RS:GetDescendants()) do hookRecv(d) end
RS.DescendantAdded:Connect(hookRecv)
log("listening for: " .. table.concat(names, ", "))

---------------------------------------------------------------- bobber height (yours only, never muted)
local tracked = {}
local function trackBobber(part)
    if tracked[part] or not part:IsA("BasePart") then return end
    if not isMine(part) then return end
    tracked[part] = true
    local where = part.Parent and part.Parent.Name or "?"
    local lastY, lastLog = nil, 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not part.Parent then
            conn:Disconnect()
            log("BOBBER(" .. where .. ") removed")
            return
        end
        local y = part.Position.Y
        if lastY == nil then
            lastY = y
            log("BOBBER(" .. where .. ") start pos " .. fmtV(part.Position))
            return
        end
        if math.abs(y - lastY) > 0.08 and os.clock() - lastLog > 0.1 then
            log(string.format("BOBBER(%s) y=%.2f dy=%+.2f pos=%s", where, y, y - lastY, fmtV(part.Position)))
            lastY, lastLog = y, os.clock()
        end
    end)
    part.AttributeChanged:Connect(function(a)
        logk("bobberattr:" .. a, "bobber attr " .. a .. " = " .. fmt(part:GetAttribute(a)))
    end)
end

---------------------------------------------------------------- sounds (yours only)
local function watchSound(s)
    if not s:IsA("Sound") then return end
    s.Played:Connect(function()
        local mine = s:IsDescendantOf(pg) or s:IsDescendantOf(SoundService) or isMine(s)
        if mine then
            logk("sound:" .. s.Name, "SOUND " .. s.Name .. " (" .. (s.Parent and s.Parent.Name or "?") .. ")")
        end
    end)
end
for _, d in ipairs(game:GetDescendants()) do pcall(watchSound, d) end

