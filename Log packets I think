---------------------------------------------------------------- helpers
local buckets = {}
local function allow(cat, max)
    local now = os.clock()
    local b = buckets[cat]
    if not b or now - b.t > 1 then
        if b and b.dropped > 0 then
            task.defer(log, string.format("(%d more '%s' skipped in the last second)", b.dropped, cat))
        end
        b = { t = now, n = 0, dropped = 0 }
        buckets[cat] = b
    end
    b.n += 1
    if b.n > max then b.dropped += 1 return false end
    return true
end

local function hex(b)
    local s = buffer.tostring(b)
    local out = table.create(#s)
    for i = 1, #s do out[i] = string.format("%02x", s:byte(i)) end
    return table.concat(out, " ")
end

local function fmtV(v) return string.format("%.1f,%.1f,%.1f", v.X, v.Y, v.Z) end

local function fmt(v)
    local t = typeof(v)
    if t == "buffer" then return "buffer(" .. buffer.len(v) .. "): " .. hex(v) end
    if t == "Instance" then return v:GetFullName() end
    if t == "Vector3" then return "V3(" .. fmtV(v) .. ")" end
    if t == "table" then
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n += 1
            if n > 8 then table.insert(parts, "...") break end
            table.insert(parts, tostring(k) .. "=" .. fmt(x))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    return tostring(v)
end

local function join(...)
    local args = table.pack(...)
    local out = {}
    for i = 1, args.n do out[i] = fmt(args[i]) end
    return table.concat(out, " | ")
end

---------------------------------------------------------------- remotes: sent
local hooked = false
if hookfunction then
    for _, def in ipairs({ { "RemoteEvent", "FireServer" }, { "RemoteFunction", "InvokeServer" }, { "UnreliableRemoteEvent", "FireServer" } }) do
        pcall(function()
            local fn = Instance.new(def[1])[def[2]]
            local old
            old = hookfunction(fn, function(self, ...)
                if typeof(self) == "Instance" and allow("send", 40) then
                    task.defer(log, "SEND " .. self.Name .. " | " .. join(...))
                end
                return old(self, ...)
            end)
            hooked = true
        end)
    end
end
if not hooked and hookmetamethod and getnamecallmethod then
    local old
    old = hookmetamethod(game, "__namecall", function(self, ...)
        local m = getnamecallmethod()
        if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" and allow("send", 40) then
            task.defer(log, "SEND " .. self.Name .. " | " .. join(...))
        end
        return old(self, ...)
    end)
    hooked = true
end
log(hooked and "send hook installed" or "NO send hook possible")

---------------------------------------------------------------- remotes: received
local names = {}
local function hookRecv(r)
    local ok = pcall(function()
        if r:IsA("RemoteEvent") or r:IsA("UnreliableRemoteEvent") then
            table.insert(names, r.Name)
            r.OnClientEvent:Connect(function(...)
                if allow("recv " .. r.Name, 15) then
                    log("RECV " .. r.Name .. " | " .. join(...))
                end
            end)
        end
    end)
end
for _, d in ipairs(RS:GetDescendants()) do hookRecv(d) end
RS.DescendantAdded:Connect(hookRecv)
log("listening for: " .. table.concat(names, ", "))

---------------------------------------------------------------- bobber height
local tracked = {}
local function trackBobber(part)
    if tracked[part] or not part:IsA("BasePart") then return end
    tracked[part] = true
    local where = part.Parent and part.Parent.Name or "?"
    local lastY, lastLog = nil, 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not part.Parent then
            conn:Disconnect()
            log("BOBBER(" .. where .. ") removed")
            return
        end
        local y = part.Position.Y
        if lastY == nil then
            lastY = y
            log("BOBBER(" .. where .. ") start pos " .. fmtV(part.Position))
            return
        end
        if math.abs(y - lastY) > 0.08 and os.clock() - lastLog > 0.1 then
            log(string.format("BOBBER(%s) y=%.2f dy=%+.2f pos=%s", where, y, y - lastY, fmtV(part.Position)))
            lastY, lastLog = y, os.clock()
        end
    end)
    part.AttributeChanged:Connect(function(a) log("bobber attr " .. a .. " = " .. tostring(part:GetAttribute(a))) end)
end

---------------------------------------------------------------- sounds
local function watchSound(s)
    if not s:IsA("Sound") then return end
    s.Played:Connect(function()
        if allow("sound", 10) then log("SOUND " .. s.Name .. " (" .. s.Parent.Name .. ")") end
    end)
end
for _, d in ipairs(game:GetDescendants()) do pcall(watchSound, d) end

---------------------------------------------------------------- new objects in the world
workspace.DescendantAdded:Connect(function(d)
    pcall(watchSound, d)
    if d.Name:lower():find("bobber", 1, true) then pcall(trackBobber, d) end
    if allow("obj", 25) then
        log("NEW OBJ " .. d.ClassName .. " " .. d:GetFullName())
    end
    if d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then
        d:GetPropertyChangedSignal("Enabled"):Connect(function()
            if allow("fx", 10) then log("FX " .. d.ClassName .. " " .. d.Name .. " enabled=" .. tostring(d.Enabled)) end
        end)
    end
end)
for _, d in ipairs(workspace:GetDescendants()) do
    if d.Name:lower():find("bobber", 1, true) then pcall(trackBobber, d) end
end

---------------------------------------------------------------- GUI changes
local function watchGui(o)
    if o:IsDescendantOf(gui) then return end
    if o:IsA("GuiObject") then
        o:GetPropertyChangedSignal("Visible"):Connect(function()
            if allow("vis", 15) then log("GUI " .. (o.Visible and "SHOW " or "hide ") .. o:GetFullName()) end
        end)
    end
    if o:IsA("TextLabel") or o:IsA("TextButton") then
        o:GetPropertyChangedSignal("Text"):Connect(function()
            local t = o.Text
            if t and t:match("%a") and #t < 80 and allow("text", 15) then
                log("TEXT " .. o:GetFullName() .. " = " .. t)
            end
        end)
    end
end
for _, d in ipairs(pg:GetDescendants()) do pcall(watchGui, d) end
pg.DescendantAdded:Connect(function(d)
    pcall(watchGui, d)
    if d:IsA("GuiObject") and not d:IsDescendantOf(gui) and allow("newgui", 15) then
        local extra = ""
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then extra = " = " .. d.Text end
        log("NEW GUI " .. d.ClassName .. " " .. d:GetFullName() .. extra)
    end
end)

